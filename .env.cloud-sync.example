# ── Plectrum cross-device cloud sync (email + password) ───────────────────────
# Cloud sync is OFF unless VITE_CLOUD_SYNC is set at build time. With it unset the
# app behaves exactly as before (songs live only in the browser's localStorage).
#
# Email+password accounts need only TWO things: a Postgres database and a secret.
# No Google/OAuth, no email-sending service.
#
# One-time setup, then it works on every device:
# 1. Add a Postgres database to the Vercel project:
#      Vercel dashboard → your project → Storage → Create → Postgres (Neon).
#    Vercel injects DATABASE_URL / POSTGRES_URL into the deployment automatically.
#    (server/db.ts creates the tables on first request; or run server/schema.sql.)
# 2. Set the two env vars below in Vercel (Production + Preview), then redeploy.
# 3. Test cross-device: on device A, sign up (email + password) in the sidebar and
#    "Sync now"; on device B, sign in with the SAME email + password → your whole
#    library appears.

# Build-time flag (client) — enables the sidebar cloud account UI + API calls.
VITE_CLOUD_SYNC=1

# Server-side — used to sign/verify session tokens (never exposed to the client).
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# DATABASE_URL is provided automatically by the Vercel Postgres integration.
# Set it here only for local dev against a remote/branch database.
# DATABASE_URL=postgres://...
