GEMINI_API_KEY=your_server_side_gemini_key_here

# Optional, for future account sync/database features.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Private Song Database Configuration
# Note: VITE_ prefix required for client-side access in Vite
# Set to 'true' to enable the local private acoustic setlist database (acoustic_setlist_db.json)
VITE_PRIVATE_SONG_DB_ENABLED=true
# Minimum confidence threshold for matching songs (0.0 to 1.0, default 0.78)
VITE_PRIVATE_SONG_DB_MIN_CONFIDENCE=0.78
# Database mode: 'json' for local file (default)
VITE_PRIVATE_SONG_DB_MODE=json

# Google Search Console verification token (HTML meta tag method)
# Get from: https://search.google.com/search-console → Add Property → HTML tag
# Paste just the content= value here (e.g., "abc123xyz")
VITE_GOOGLE_SITE_VERIFICATION=

