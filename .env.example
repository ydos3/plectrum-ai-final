GEMINI_API_KEY=your_gemini_api_key_here

# Optional, public-safe account sync/database settings.
VITE_SUPABASE_URL=your_public_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_public_supabase_anon_key_here

# Private Song Database Configuration
# VITE_ prefix is used only for non-secret client-side feature flags.
VITE_PRIVATE_SONG_DB_ENABLED=true
VITE_PRIVATE_SONG_DB_MIN_CONFIDENCE=0.78
VITE_PRIVATE_SONG_DB_MODE=json

# Google Search Console verification token (HTML meta tag method).
# Paste just the content= value here (e.g., "abc123xyz").
VITE_GOOGLE_SITE_VERIFICATION=
